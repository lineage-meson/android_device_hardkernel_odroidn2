# Inherit from mainline/qcom-common
include device/mainline/amlogic-common/BoardConfigAmlogic.mk

# Bootloader
BOARD_PREBUILT_BOOTLOADER=$(INSTALLED_BOOTLOADER_TARGET)
TARGET_BOOTLOADER_BOARD_NAME := odroidn2
TARGET_BOOTLOADER_CFG := $(DEVICE_PATH)/bootloader.cfg
TARGET_BOOTLOADER_SOURCE := external/u-boot
TARGET_NO_BOOTLOADER := $(strip $(if $(wildcard $(TARGET_BOOTLOADER_SOURCE)/Makefile),false,true))

# Kernel
AMLOGIC_ANDROIDBOOT_PARAMS += \
    androidboot.hardware=odroidn2 \
    androidboot.boot_devices=soc/ffe07000.mmc
BOARD_BOOT_HEADER_VERSION := 2
BOARD_DTB_CFG := $(DEVICE_PATH)/odroidn2-dtb.cfg
BOARD_DTBO_CFG := $(DEVICE_PATH)/odroidn2-dtbo.cfg
BOARD_INCLUDE_DTB_IN_BOOTIMG := true
BOARD_KERNEL_CMDLINE := \
    $(AMLOGIC_ANDROIDBOOT_PARAMS) \
    $(AMLOGIC_KERNEL_PARAMS) \
    no_console_suspend \
    earlycon \
    printk.devkmsg=on \
    init=/init \
    log_buf_len=1M
BOARD_KERNEL_OFFSET := 0x1080000
BOARD_KERNEL_PAGESIZE := 4096
BOARD_KERNEL_SEPARATED_DTBO := true
BOARD_KERNEL_TAGS_OFFSET := 0x1000000
BOARD_MKBOOTIMG_ARGS += \
    --kernel_offset $(BOARD_KERNEL_OFFSET) \
    --ramdisk_offset $(BOARD_RAMDISK_OFFSET) \
    --header_version $(BOARD_BOOT_HEADER_VERSION)
BOARD_RAMDISK_OFFSET := 0x4000000
TARGET_DTB_LIST_WILDCARD := \
    amlogic/meson-g12b-odroid-n2 \
    amlogic/meson-g12b-odroid-n2-plus

# Metadata
BOARD_USES_METADATA_PARTITION := true

# Partitions
BOARD_BOOTIMAGE_PARTITION_SIZE := 67108864
BOARD_BUILD_SUPER_IMAGE_BY_DEFAULT := true
BOARD_CACHEIMAGE_PARTITION_SIZE := 268435456
BOARD_CACHEIMAGE_FILE_SYSTEM_TYPE := ext4
BOARD_DB_DYNAMIC_PARTITIONS_PARTITION_LIST := system system_dlkm vendor vendor_dlkm
BOARD_DB_DYNAMIC_PARTITIONS_SIZE := 2411724800
BOARD_DTBOIMG_PARTITION_SIZE := 8388608
BOARD_RECOVERYIMAGE_PARTITION_SIZE := $(BOARD_BOOTIMAGE_PARTITION_SIZE)
BOARD_SUPER_IMAGE_IN_UPDATE_PACKAGE := true
BOARD_SUPER_PARTITION_GROUPS := db_dynamic_partitions
BOARD_SUPER_PARTITION_METADATA_DEVICE := super
BOARD_SUPER_PARTITION_SIZE := 2415919104
BOARD_SYSTEM_DLKMIMAGE_FILE_SYSTEM_TYPE := ext4
BOARD_SYSTEMIMAGE_FILE_SYSTEM_TYPE := ext4
BOARD_VENDOR_DLKMIMAGE_FILE_SYSTEM_TYPE := ext4
BOARD_VENDORIMAGE_FILE_SYSTEM_TYPE := ext4
TARGET_COPY_OUT_SYSTEM_DLKM := system_dlkm
TARGET_COPY_OUT_VENDOR := vendor
TARGET_COPY_OUT_VENDOR_DLKM := vendor_dlkm

# Recovery
BOARD_INCLUDE_RECOVERY_DTBO := true
TARGET_RECOVERY_FSTAB ?= $(DEVICE_PATH)/fstab/fstab.odroidn2
