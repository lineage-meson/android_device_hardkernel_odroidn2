#

# Boot
/dev/block/by-name/boot /boot emmc defaults defaults

# Cache
/dev/block/by-name/cache /cache ext4 nodev,noatime,nosuid,discard check,formattable
/dev/block/by-name/cache /cache f2fs nodev,noatime,nosuid,discard check,formattable

# Metadata
/dev/block/by-name/metadata /metadata ext4 nodev,noatime,nosuid,discard,data=journal,commit=1 check,formattable,first_stage_mount,metadata_csum

# Misc
/dev/block/by-name/misc /misc emmc defaults defaults

# Recovery
/dev/block/by-name/recovery /recovery emmc defaults defaults

# SDcard
*/block/mmcblk0 auto auto defaults voldmanaged=sdcard:auto,encryptable=userdata

# System
system /system ext4 ro,barrier=1 wait,check,logical,first_stage_mount

# System DLKM
system_dlkm /system_dlkm ext4 ro,barrier=1 wait,check,logical,first_stage_mount

# USB
*/block/sd* auto auto defaults voldmanaged=usb:auto,noemulatedsd

# Userdata
/dev/block/by-name/userdata /data ext4 nodev,noatime,nosuid,discard latemount,check,quota,formattable
/dev/block/by-name/userdata /data f2fs nodev,noatime,nosuid,discard,reserve_root=32768 latemount,check,quota,formattable

# Vendor
vendor /vendor ext4 ro,barrier=1 wait,check,logical,first_stage_mount

# Vendor DLKM
vendor_dlkm /vendor_dlkm ext4 ro,barrier=1 wait,check,logical,first_stage_mount

# ZRAM
/dev/block/zram0 none swap defaults zramsize=50%
